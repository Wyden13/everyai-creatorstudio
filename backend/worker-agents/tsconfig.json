{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/remotion/theme-widgets.tsx",
    "src/vox/VoxVideo.tsx",
    "src/remotion/remotion-shim.d.ts"
  ]
}
