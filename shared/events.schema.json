{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyai.creatorstudio/schemas/events.schema.json",
  "title": "RealtimeEvent",
  "description": "Wire envelope for Redis Pub/Sub -> Anole WebSocket/WebTransport server-to-board events.",
  "type": "object",
  "required": ["event_type", "workspace_id", "timestamp", "payload"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "node.status_changed",
        "node.log_chunk",
        "node.queue_updated",
        "worker.health_check",
        "architect.step_update",
        "publish.metrics_updated"
      ]
    },
    "workspace_id": { "type": "string" },
    "node_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
