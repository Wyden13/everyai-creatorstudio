{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyai.creatorstudio/schemas/widget-spec.schema.json",
  "title": "DynamicBoardWidgetSpec",
  "description": "Declarative JSON UI Spec rendered safely by <DynamicBoardNode/> (Tier 1) or Admin-gated Sandboxed TSX (Tier 2).",
  "oneOf": [
    {
      "type": "object",
      "required": ["spec_type", "archetype", "title", "data_endpoint", "blocks"],
      "properties": {
        "spec_type": { "const": "declarative_json" },
        "archetype": { "type": "string", "enum": ["agent", "status", "tracker", "aggregator"] },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "data_endpoint": { "type": "string", "pattern": "^/api/" },
        "poll_interval_ms": { "type": "integer", "minimum": 1000, "default": 15000 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "id": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": [
                  "metric_card",
                  "progress_bar",
                  "table",
                  "trigger_button",
                  "status_strip",
                  "list_aggregator"
                ]
              },
              "label": { "type": "string" },
              "value_path": { "type": "string" },
              "action_endpoint": { "type": "string", "pattern": "^/api/" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["spec_type", "archetype", "title", "tsx_source", "approval_status"],
      "properties": {
        "spec_type": { "const": "sandboxed_tsx" },
        "archetype": { "type": "string", "enum": ["agent", "status", "tracker", "aggregator"] },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "tsx_source": { "type": "string", "minLength": 1 },
        "data_endpoint": { "type": "string", "pattern": "^/api/" },
        "approval_status": { "type": "string", "enum": ["pending_admin", "approved", "rejected"] }
      },
      "additionalProperties": false
    }
  ]
}
