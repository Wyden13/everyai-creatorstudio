{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyai.creatorstudio/schemas/storyboard.schema.json",
  "title": "Storyboard",
  "description": "Structured output contract produced by the Screenplay Agent and approved by a human before Voiceover & Animation.",
  "type": "object",
  "required": ["video_id", "title", "hook", "aspect_ratios", "scenes"],
  "properties": {
    "video_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "hook": { "type": "string", "minLength": 1 },
    "source_topic": { "type": "string" },
    "aspect_ratios": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["16:9", "9:16"] },
      "uniqueItems": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "index", "narration", "visual_directive", "animation_engine"],
        "properties": {
          "scene_id": { "type": "string", "minLength": 1 },
          "index": { "type": "integer", "minimum": 0 },
          "narration": { "type": "string", "minLength": 1 },
          "visual_directive": { "type": "string", "minLength": 1 },
          "animation_engine": { "type": "string", "enum": ["remotion", "manim", "hybrid"] },
          "primitive_hints": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "animated_chart",
                "map_callout",
                "kinetic_typography",
                "data_card",
                "equation_morph",
                "vector_graph"
              ]
            }
          },
          "estimated_duration_ms": { "type": "integer", "minimum": 500 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
