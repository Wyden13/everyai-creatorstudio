# === Core Application Infrastructure ONLY ===
# All third-party AI keys, social OAuth logins, storage connectors (Google Drive / S3),
# and research tools are managed per-Organization inside the encrypted Postgres Org Vault.

ANOLE_HOST=0.0.0.0
ANOLE_PORT=8080
ANOLE_TLS_PORT=8443
ANOLE_ENV=development

# === Security, Hashing & Vault Master Keys ===
# 64 hex chars (32 bytes) for AES-256-GCM Org Vault encryption
VAULT_MASTER_KEY=replace_with_64_hex_char_key
# 32 random bytes base64 (`openssl rand -base64 32`) for sealed cookie sessions
SESSION_KEY=replace_with_base64_32_bytes
INTERNAL_WORKER_TOKEN=replace_with_shared_internal_secret
DEV_ADMIN_PASSWORD=creatorstudio-dev

# === Database & Queue (Non-containerized on VM) ===
DATABASE_URL=postgres://creatorstudio:password@127.0.0.1:5432/creatorstudio
REDIS_URL=redis://127.0.0.1:6379/0

# === Frontend Dev Endpoints ===
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
VITE_ARCHITECT_URL=http://localhost:8081

# === Optional: Automated Test Keys Only (never used in production runtime) ===
# ANTHROPIC_TEST_API_KEY=
