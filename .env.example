# === Core Server (Anole / Zig) ===
ANOLE_HOST=0.0.0.0
ANOLE_PORT=8080
ANOLE_TLS_PORT=8443
ANOLE_ENV=development

# === Security & Vault ===
# 64 hex chars (32 bytes) for AES-256-GCM org key vault encryption
VAULT_MASTER_KEY=replace_with_64_hex_char_key
JWT_SECRET=replace_with_random_secret
INTERNAL_WORKER_TOKEN=replace_with_shared_internal_secret

# === Database & Queue (Non-containerized on VM) ===
DATABASE_URL=postgres://creatorstudio:password@127.0.0.1:5432/creatorstudio
REDIS_URL=redis://127.0.0.1:6379/0

# === Media Storage (gdrive primary, s3 fallback) ===
STORAGE_BACKEND=gdrive
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Optional S3-compatible fallback
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# === Frontend ===
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
